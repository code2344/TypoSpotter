{
  "name": "typospotter",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "description": "A human-reviewed typo fixing userscript for English Wikipedia",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && vitest run",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "node scripts/version.mjs patch",
    "version:minor": "node scripts/version.mjs minor",
    "version:major": "node scripts/version.mjs major"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
